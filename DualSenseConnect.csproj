<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DualSenseConnect</AssemblyName>
    <RootNamespace>DualSenseConnect</RootNamespace>
    <Version>1.6.0</Version>
    <!-- Show "1.6.0" in the file properties, without the git commit hash appended by the SDK -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Product>DualSenseConnect</Product>
    <AssemblyTitle>DualSenseConnect</AssemblyTitle>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- Tiny background app: favour low memory over GC throughput -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
    <!-- The GC sizes its young generation from the CPU cache (96 MB on a 7800X3D), so the Opus
         encoder's ~5 MB/s of short-lived garbage piled up to ~50 MB before the first collection.
         A hard limit makes it collect early; live data is under 5 MB. Measured: 51 MB -> 18 MB peak. -->
    <RuntimeHostConfigurationOption Include="System.GC.HeapHardLimit" Value="33554432" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Concentus" Version="2.2.2" />
    <PackageReference Include="HidSharp" Version="2.1.0" />
    <PackageReference Include="NAudio.Wasapi" Version="3.3.0" />
  </ItemGroup>

</Project>
